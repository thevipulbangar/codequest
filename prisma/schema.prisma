// OrbitPass backend schema (Postgres / Supabase).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  operator
  owner
  admin
}

enum DocStatus {
  submitted
  approved
  rejected
  more_info
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            Role
  // profile
  jobTitle        String?
  phone           String?
  country         String?
  company         String?
  companyType     String?
  website         String?
  about           String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions      Session[]
  verification  Verification?
  reviews       AuditLog[]      @relation("actor")
  satellites    Satellite[]
  stations      GroundStation[]
  credit        CreditAccount?
  ledger        LedgerEntry[]
  bookings      Booking[]       @relation("operatorBookings")
  disputes      Dispute[]       @relation("disputeRaiser")
  notifications Notification[]
  tokens        AuthToken[]
}

/// An asset is visible/bookable only when status = active AND its owner's verification is approved.
enum AssetStatus {
  pending
  active
  rejected
  suspended
}

model Satellite {
  id             String      @id @default(uuid())
  ownerId        String
  owner          User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  noradId        Int         @unique
  intlDesignator String?
  band           String // VHF | UHF | L | S | X | Ku | Ka
  downlinkMHz    Float
  protocol       String
  bookings       Booking[]
  status         AssetStatus @default(pending)
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([ownerId])
  @@index([status])
}

model GroundStation {
  id           String         @id @default(uuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  country      String
  latitude     Float
  longitude    Float
  altitudeM    Float          @default(0)
  antennaType  String
  antennaSizeM Float
  bands        String[]
  protocols    String[]
  pricePerPass Decimal        @db.Decimal(12, 2)
  /// ed25519 public key (SPKI DER, hex) used to verify the station's signed downlink receipts
  publicKey    String?
  blocks       StationBlock[]
  bookings     Booking[]
  status       AssetStatus    @default(pending)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ownerId])
  @@index([status])
}

/// Opaque session tokens; only the SHA-256 of the token is stored.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Verification {
  id           String       @id @default(uuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  setup        Json // lib/verification/requirements.ts Setup
  decision     String? // approved | rejected | more_info
  decisionNote String?
  decidedAt    DateTime?
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
}

model Submission {
  id             String       @id @default(uuid())
  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  docId          String
  status         DocStatus    @default(submitted)
  // file docs: encrypted object in storage; we keep metadata + plaintext SHA-256 for integrity
  fileName       String?
  mimeType       String?
  size           Int?
  sha256         String?
  storageKey     String?
  text           String? // text docs (CIN, PAN, NORAD...)
  notApplicable  String? // reason for "where applicable" docs
  reviewNote     String?
  submittedAt    DateTime     @default(now())
  reviewedAt     DateTime?

  @@unique([verificationId, docId])
  @@index([status])
}

/// Every admin action and document access is recorded.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("actor", fields: [actorId], references: [id])
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([target])
}

/// Periods when a station is NOT available for bookings (maintenance, own use...).
model StationBlock {
  id        String        @id @default(uuid())
  stationId String
  station   GroundStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime
  reason    String?
  createdAt DateTime      @default(now())

  @@index([stationId, start])
}

enum BookingStatus {
  confirmed // escrow locked
  manifest_committed // operator committed the frame manifest (immutable)
  settled // receipt verified, escrow released pro-rata
  cancelled // cancelled before AOS, fully refunded
  expired // no receipt within the deadline, fully refunded
}

model Booking {
  id             String        @id @default(uuid())
  operatorId     String
  operator       User          @relation("operatorBookings", fields: [operatorId], references: [id])
  satelliteId    String
  satellite      Satellite     @relation(fields: [satelliteId], references: [id])
  stationId      String
  station        GroundStation @relation(fields: [stationId], references: [id])
  aos            DateTime
  los            DateTime
  maxElDeg       Float
  price          Decimal       @db.Decimal(12, 2)
  feeBps         Int
  status         BookingStatus @default(confirmed)
  manifest       Json?
  manifestRoot   String?
  framesPromised Int?
  receipt        Json?
  report         Json?
  framesVerified Int?
  deliveryBps    Int?
  stationGross   Decimal?      @db.Decimal(12, 2)
  platformFee    Decimal?      @db.Decimal(12, 2)
  stationNet     Decimal?      @db.Decimal(12, 2)
  operatorRefund Decimal?      @db.Decimal(12, 2)
  settledAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ledger         LedgerEntry[]
  disputes       Dispute[]

  @@index([stationId, aos])
  @@index([operatorId, aos])
  @@index([status])
}

/// Platform credits (no real money yet). Balance changes only through LedgerEntry, atomically.
model CreditAccount {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt
}

enum LedgerType {
  credit_grant
  escrow_lock
  payout
  refund
  platform_fee
  adjustment
}

/// Append-only. userId NULL = platform account. For every booking: escrow_lock = payout + platform_fee + refund.
model LedgerEntry {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  bookingId    String?
  booking      Booking?   @relation(fields: [bookingId], references: [id])
  type         LedgerType
  amount       Decimal    @db.Decimal(14, 2)
  balanceAfter Decimal?   @db.Decimal(14, 2)
  note         String?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([bookingId])
}

enum DisputeStatus {
  open
  resolved
  rejected
}

model Dispute {
  id           String        @id @default(uuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id])
  raisedById   String
  raisedBy     User          @relation("disputeRaiser", fields: [raisedById], references: [id])
  reason       String
  evidence     String?
  status       DisputeStatus @default(open)
  resolution   String?
  refundAmount Decimal?      @db.Decimal(12, 2)
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@index([status])
  @@index([bookingId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// One-time tokens (password reset, email verification). Only the SHA-256 is stored.
model AuthToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // reset | verify_email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

/// Shared rate-limit counters (work across all server instances).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
