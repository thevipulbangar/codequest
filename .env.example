# Copy to .env (local) and add the same keys in Netlify -> Site configuration -> Environment variables.
# Never commit .env.

# --- Database (Supabase -> Connect -> ORMs -> Prisma) ---------------------------------------------
# If your DB password has special characters, URL-encode them (# -> %23, @ -> %40, / -> %2F, : -> %3A),
# or reset it to letters + numbers only.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Document storage (Supabase -> Project Settings -> API Keys: secret key). Server-only. ------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<secret-key>"
SUPABASE_BUCKET="verification-docs"

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this makes already-uploaded documents unreadable.
DOC_ENCRYPTION_KEY="<base64-32-bytes>"

# --- App ---------------------------------------------------------------------------------------------
# Public URL used in email links (never taken from request headers).
APP_URL="https://orbitpasss.netlify.app"
# Platform fee in basis points, taken from the station's earned share (800 = 8%, max 2000).
PLATFORM_FEE_BPS="800"

# --- Email (optional; password reset, email confirmation, notification emails) ------------------------
# Resend: https://resend.com -> API Keys. EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="OrbitPass <no-reply@your-domain.com>"
